# ==============================================================================
# JACKTHENEWS: Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local and populate with your verified credentials.
# NEVER commit .env.local or raw credentials to source control.

# ------------------------------------------------------------------------------
# Supabase Configuration (Primary Database & Authentication)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-for-admin-server-routes
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000/auth/callback

# ------------------------------------------------------------------------------
# AI Engine Configuration (OpenAI API)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# News Aggregation Provider APIs
# ------------------------------------------------------------------------------
# NewsData.io API (Primary Global & Category Provider)
NEWSDATA_API_KEY=your-newsdata-api-key

# Mediastack API (Secondary Fallback Provider)
MEDIASTACK_API_KEY=your-mediastack-api-key

# TheNewsAPI (Tertiary Fallback Provider)
THENEWSAPI_KEY=your-thenewsapi-key

# ------------------------------------------------------------------------------
# Optional: Firebase Configuration (Legacy/Secondary integrations only)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ------------------------------------------------------------------------------
# Application Environment
# ------------------------------------------------------------------------------
NODE_ENV=development
